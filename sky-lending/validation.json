{
  "_comment": "Validation config for tools/compare. This single port serves BOTH queue rows 'Sky Lending (#13)' and 'Sky RWA (#49)' (the Messari makerdao subgraph indexes the entire Maker/Sky Vat, including RWA ilks). Source: messari/subgraphs subgraphs/makerdao @ commit 2711ac91ef119f321f65b339e10a57f9aa74f9d8.",
  "subgraph": {
    "_comment_url": "TODO: the Messari makerdao subgraph is published on The Graph decentralized network, but the sparse checkout did not include the deployment registry (deployment/deployment.json) so a concrete subgraph deployment id was not found. Replace <SUBGRAPH_ID> with the makerdao subgraph's decentralized-network id (gateway endpoint pattern below) and provide GRAPH_API_KEY. The legacy hosted-service slug was 'messari/makerdao'.",
    "url": "https://gateway.thegraph.com/api/subgraphs/id/<SUBGRAPH_ID>",
    "authEnv": "GRAPH_API_KEY"
  },
  "local": {
    "url": "http://localhost:8080/v1/graphql",
    "adminSecret": "testing"
  },
  "blockRange": {
    "_comment": "Rendered mainnet Vat start block (8928152) -> +50k. Uncomment end_block in config.yaml for a matching bounded run.",
    "start": 8928152,
    "end": 8978152
  },
